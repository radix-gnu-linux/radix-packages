#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
keyring=${1:-/usr/share/keyrings/debian-archive-keyring.gpg}

if [ ! -f "$keyring" ]; then
    echo "Debian archive keyring not found: $keyring" >&2
    echo "usage: $0 /path/to/debian-archive-keyring.gpg" >&2
    exit 2
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/radix-sid-refresh.XXXXXXXX")
cleanup() {
    rm -rf -- "$work"
}
trap cleanup EXIT HUP INT TERM

base=https://deb.debian.org/debian/dists/sid
curl -fL --proto '=https' --tlsv1.2 --retry 3 \
    --output "$work/InRelease" "$base/InRelease"

for component in main contrib non-free non-free-firmware; do
    curl -fL --proto '=https' --tlsv1.2 --retry 3 \
        --output "$work/$component-Sources.xz" \
        "$base/$component/source/Sources.xz"
    python3 "$root/tools/import-debian-sources.py" \
        "$work/$component-Sources.xz" "$work/InRelease" \
        --keyring "$keyring" --suite sid --component "$component" \
        --output "$work/debian-sid-$component.toml"
done

for component in main contrib non-free non-free-firmware; do
    cp "$work/debian-sid-$component.toml" \
        "$root/ports/sources/debian-sid-$component.toml"
done

python3 "$root/tools/render-pinned-ports.py"
"$root/tools/check-tree"
